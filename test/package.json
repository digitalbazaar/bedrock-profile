{
  "name": "bedrock-profile-test",
  "version": "0.0.1-0",
  "type": "module",
  "description": "Bedrock Profile test",
  "private": true,
  "scripts": {
    "test": "node --preserve-symlinks test.js test",
    "debug": "node --preserve-symlinks test.js test --log-level debug",
    "coverage": "cross-env NODE_ENV=test c8 npm test",
    "coverage-ci": "cross-env NODE_ENV=test c8 --reporter=lcovonly --reporter=text-summary --reporter=text npm test",
    "coverage-report": "c8 report"
  },
  "dependencies": {
    "@bedrock/account": "^10.1.0",
    "@bedrock/app-identity": "^4.2.0",
    "@bedrock/core": "^6.3.0",
    "@bedrock/did-context": "^6.0.0",
    "@bedrock/did-io": "^10.5.0",
    "@bedrock/edv-storage": "^20.1.1",
    "@bedrock/express": "^8.8.4",
    "@bedrock/https-agent": "^4.1.0",
    "@bedrock/jsonld-document-loader": "^5.2.1",
    "@bedrock/kms": "^16.2.0",
    "@bedrock/kms-http": "^22.1.0",
    "@bedrock/ledger-context": "^25.0.0",
    "@bedrock/meter": "^6.0.0",
    "@bedrock/meter-http": "^14.0.0",
    "@bedrock/meter-usage-reporter": "^10.3.5",
    "@bedrock/mongodb": "^11.0.1",
    "@bedrock/package-manager": "^3.0.0",
    "@bedrock/passport": "^12.1.0",
    "@bedrock/profile": "file:..",
    "@bedrock/record-cipher": "^1.2.0",
    "@bedrock/security-context": "^9.0.0",
    "@bedrock/server": "^5.2.1",
    "@bedrock/ssm-mongodb": "^13.3.0",
    "@bedrock/test": "^8.3.0",
    "@bedrock/validation": "^7.4.0",
    "@bedrock/veres-one-context": "^16.0.0",
    "@bedrock/zcap-storage": "^9.7.0",
    "@digitalbazaar/ed25519-signature-2020": "^5.4.0",
    "@digitalbazaar/edv-client": "^16.3.0",
    "@digitalbazaar/ezcap": "^4.4.0",
    "@digitalbazaar/webkms-client": "^14.3.1",
    "@digitalbazaar/zcap": "^9.0.3",
    "c8": "^10.1.3",
    "cross-env": "^7.0.3"
  },
  "c8": {
    "excludeNodeModules": false,
    "include": [
      "node_modules/@bedrock/profile/**"
    ],
    "exclude": [
      "node_modules/@bedrock/profile/node_modules/**"
    ],
    "reporter": [
      "lcov",
      "text-summary",
      "text"
    ]
  }
}
